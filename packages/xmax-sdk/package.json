{
  "name": "@xmax/sdk",
  "version": "0.1.0",
  "description": "XmaxSDK for Web — Realtime Interactive Video Generation",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node scripts/embed-framegen.mjs && tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.64",
    "tsup": "^8.3.5",
    "typescript": "~5.6.3",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "framegen": "1.4.0",
    "cos-js-sdk-v5": "^1.10.1",
    "trtc-sdk-v5": "^5.6.0"
  }
}
