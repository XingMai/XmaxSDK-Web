{
  "name": "@xmaxai/web-sdk",
  "version": "1.0.6",
  "license": "MIT",
  "description": "XmaxSDK for Web — Realtime Interactive Video Generation",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/embed-framegen.mjs && tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "cp ../../README.md ./README.md",
    "prepublishOnly": "npm run build && npm run test && cp ../../README.md ./README.md"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "react": "^18.3.1",
    "@webgpu/types": "^0.1.64",
    "tsup": "^8.3.5",
    "typescript": "~5.6.3",
    "vitest": "^2.1.8"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "@volcengine/rtc": "4.69.3",
    "agora-rtc-sdk-ng": "4.24.8",
    "framegen": "1.4.0",
    "cos-js-sdk-v5": "^1.10.1",
    "trtc-sdk-v5": "^5.6.0"
  }
}
