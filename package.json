{
  "name": "xmax-sdk-web",
  "private": true,
  "version": "1.0.1",
  "license": "MIT",
  "description": "XmaxSDK for Web — Realtime Interactive Video Generation",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "ci:check": "bash .cicd/ci-check.sh",
    "ci:test": "node --test .cicd/tests/*.test.mjs",
    "build": "pnpm -r --filter './packages/*' build",
    "test": "pnpm -r --filter './packages/*' test",
    "typecheck": "pnpm -r --filter './packages/*' typecheck",
    "dev": "pnpm --filter xlab-react dev"
  },
  "devDependencies": {
    "typescript": "~5.6.3"
  },
  "engines": {
    "node": ">=18"
  }
}
